NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=warehouse_db
DB_USER=root
DB_PASSWORD=

DB_CONNECTION_LIMIT=10

LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
IDEMPOTENCY_TTL_HOURS=24

AUTH_JWKS_URL=http://localhost:5020/.well-known/jwks.json
AUTH_JWT_ISSUER=https://auth.local/
AUTH_JWT_AUDIENCE=warehouse-system-api
AUTH_MODE=hybrid

# Push notifications (Firebase Admin SDK) — download from Firebase Console →
# Project Settings → Service Accounts → Generate new private key, save it as
# keys/firebase-service-account.json (gitignored, bind-mounted in production
# the same way skinet-auth-api mounts its JWT keys). Missing file is fine for
# local dev — push sending just becomes a no-op.
FIREBASE_SERVICE_ACCOUNT_PATH=./keys/firebase-service-account.json
